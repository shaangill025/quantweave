{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Simulated Fill",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "simulated_order_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "filled_at": {
      "type": "string",
      "format": "date-time"
    },
    "quantity": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 60
    },
    "price": {
      "$ref": "common.schema.json#/$defs/Money"
    },
    "fees": {
      "$ref": "common.schema.json#/$defs/Money"
    },
    "data_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "assumption_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "execution_model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "actual_execution": {
      "const": false
    }
  },
  "required": [
    "id",
    "simulated_order_id",
    "filled_at",
    "quantity",
    "price",
    "fees",
    "data_record_ids",
    "assumption_ids",
    "execution_model_id",
    "actual_execution"
  ],
  "additionalProperties": false
}
