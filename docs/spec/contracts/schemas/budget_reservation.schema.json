{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Budget Reservation",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "period": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}$"
    },
    "category": {
      "type": "string",
      "enum": [
        "monitoring",
        "verification",
        "research",
        "improvement"
      ]
    },
    "currency": {
      "const": "USD"
    },
    "reserved_amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 60
    },
    "actual_amount": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "reserved",
        "settled",
        "released",
        "expired"
      ]
    },
    "provider_account_reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "max_output_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "scope_id",
    "period",
    "category",
    "currency",
    "reserved_amount",
    "actual_amount",
    "status",
    "provider_account_reference",
    "max_output_tokens",
    "created_at"
  ],
  "additionalProperties": false
}
