{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared value types; financial decimals are strings",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "Decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 60
    },
    "NonnegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 60
    },
    "Hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "Money": {
      "type": "object",
      "properties": {
        "amount": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 60
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "amount",
        "currency"
      ],
      "additionalProperties": false
    },
    "Reason": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "message": {
          "type": "string",
          "maxLength": 1500
        },
        "affected_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        },
        "blocking": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "affected_ids",
        "blocking"
      ],
      "additionalProperties": false
    },
    "Qualification": {
      "type": "object",
      "properties": {
        "operational": {
          "type": "string",
          "enum": [
            "not_tested",
            "passed",
            "failed",
            "suspended"
          ]
        },
        "investment_evidence": {
          "type": "string",
          "enum": [
            "none",
            "limited",
            "historical",
            "prospective_limited",
            "qualified_for_declared_claim"
          ]
        },
        "user_eligibility": {
          "type": "string",
          "enum": [
            "not_evaluated",
            "eligible",
            "ineligible"
          ]
        },
        "policy_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        }
      },
      "required": [
        "operational",
        "investment_evidence",
        "user_eligibility",
        "policy_version_id",
        "reason_codes"
      ],
      "additionalProperties": false
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "source_record_id": {
          "type": "string"
        },
        "event_at": {
          "type": "string",
          "format": "date-time"
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "publication_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "retrieval_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rights_profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "source_id",
        "source_record_id",
        "event_at",
        "received_at",
        "publication_at",
        "retrieval_hash",
        "rights_profile_id"
      ],
      "additionalProperties": false
    },
    "VersionBinding": {
      "type": "object",
      "properties": {
        "account_revision": {
          "type": "integer",
          "minimum": 1
        },
        "policy_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "strategy_version_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "feed_spec_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "entitlement_revision": {
          "type": "integer",
          "minimum": 1
        },
        "portfolio_snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "account_revision",
        "policy_version_id",
        "strategy_version_id",
        "feed_spec_id",
        "entitlement_revision",
        "portfolio_snapshot_id"
      ],
      "additionalProperties": false
    },
    "Problem": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "status": {
          "type": "integer",
          "minimum": 400,
          "maximum": 599
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "detail": {
          "type": "string"
        },
        "trace_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Reason"
          }
        }
      },
      "required": [
        "type",
        "title",
        "status",
        "code",
        "detail",
        "trace_id",
        "reasons"
      ],
      "additionalProperties": false
    },
    "ReferenceList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      },
      "uniqueItems": true
    },
    "Condition": {
      "type": "object",
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "operator": {
          "type": "string",
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "eq",
            "between",
            "in",
            "not_in"
          ]
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_spec_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "metric",
        "operator",
        "values",
        "data_spec_id",
        "description"
      ],
      "additionalProperties": false
    },
    "ManifestFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "content_class": {
          "type": "string",
          "enum": [
            "financial",
            "policy",
            "research",
            "private_learning",
            "audit",
            "metadata"
          ]
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes",
        "content_class"
      ],
      "additionalProperties": false
    }
  }
}
