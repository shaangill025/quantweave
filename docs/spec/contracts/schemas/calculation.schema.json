{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Calculation",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "formula_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "formula_version": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string",
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
            "maxLength": 60
          },
          "unit": {
            "type": "string"
          },
          "source_record_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          }
        },
        "required": [
          "name",
          "value",
          "unit",
          "source_record_id"
        ],
        "additionalProperties": false
      }
    },
    "result": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "maxLength": 60
        },
        {
          "type": "null"
        }
      ]
    },
    "unit": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "insufficient_inputs",
        "ambiguous",
        "unsupported",
        "undefined"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_snapshot_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "formula_id",
    "formula_version",
    "inputs",
    "result",
    "unit",
    "status",
    "warnings",
    "input_snapshot_hash",
    "computed_at"
  ],
  "additionalProperties": false
}
