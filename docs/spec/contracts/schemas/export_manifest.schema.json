{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Export Manifest",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "format_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/ManifestFile"
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record_class": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "record_class",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "contains_credentials": {
      "const": false
    },
    "contains_executable_code": {
      "const": false
    },
    "required_reconnections": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
      }
    },
    "compatibility_version": {
      "type": "string"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "id",
    "format_version",
    "created_at",
    "scope_id",
    "files",
    "omissions",
    "contains_credentials",
    "contains_executable_code",
    "required_reconnections",
    "compatibility_version",
    "content_hash"
  ],
  "additionalProperties": false
}
